      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json.message || {};\nreturn { json: {\n  chat_id: m.chat?.id,\n  user: [m.from?.first_name, m.from?.last_name].filter(Boolean).join(' ') + (m.from?.username ? ' @' + m.from.username : ''),\n  text: (m.text || '').trim() || '[non-text message]',\n  is_start: (m.text || '').startsWith('/start')\n}};"
      },
