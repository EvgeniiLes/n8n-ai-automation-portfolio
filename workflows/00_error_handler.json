{
  "name": "GearUp 00 · Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## 🚨 Global error handler\nSet this workflow as **Error workflow** in Settings of every other GearUp workflow.\nAny failed execution → Telegram alert to the owner + row in `ErrorLog` sheet.",
        "height": 180,
        "width": 420,
        "color": 3
      },
      "id": "7ac8d5a0-84d0-460a-8627-9deae5dba2ef",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "6197a77d-1f16-497c-a75b-c9423268498d",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst e = $json;\nconst wfName = e.workflow?.name || 'unknown';\nconst node = e.execution?.lastNodeExecuted || e.trigger?.error?.node?.name || '-';\nconst msg = e.execution?.error?.message || e.trigger?.error?.message || 'Unknown error';\nconst url = e.execution?.url || '';\nreturn [{ json: {\n  ts: new Date().toISOString().slice(0,16).replace('T',' '),\n  workflow: wfName, node, error: msg.slice(0, 500), execution_url: url,\n  text: `🚨 <b>Workflow failed</b>\\n<b>${esc(wfName)}</b> → node <code>${esc(node)}</code>\\n\\n${esc(msg.slice(0,300))}` + (url ? `\\n\\n<a href=\"${url}\">Open execution</a>` : '')\n}}];"
      },
      "id": "840666b8-2673-4654-94f7-24dc10f31daa",
      "name": "Format error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
