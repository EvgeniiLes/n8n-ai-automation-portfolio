    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Extract site info').first().json;\nlet ai = {};\ntry {\n  const raw = String($json.text || '').replace(/```json|```/g, '').trim();\n  ai = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n} catch (e) {\n  ai = { score: 0, tier: 'review', reason: 'AI response could not be parsed – manual review', next_step: 'Check manually' };\n}\nconst score = Math.max(0, Math.min(100, Number(ai.score) || 0));\nreturn { json: { ...lead, score, tier: ai.tier || 'review', reason: ai.reason || '', next_step: ai.next_step || '',\n  products: (ai.products || []).join(', '), email_subject: ai.email_subject || '', email_body: ai.email_body || '', status: 'new' } };"
      },
