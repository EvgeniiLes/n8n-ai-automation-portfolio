{
  "name": "GearUp 01 · B2B Lead Qualification (AI)",
  "nodes": [
    {
      "parameters": {
        "content": "## 1️⃣ Wholesale lead → AI scoring → CRM\nGyms and studios fill the wholesale form on the site.\n1. Validate & normalize the lead\n2. Enrich: fetch the company website\n3. Claude scores the lead 0-100 and drafts a personal first email\n4. Save to CRM (`Leads` sheet)\n5. Hot lead (≥70) → instant Telegram alert to sales\n6. Warm/hot → first-touch email sent automatically",
        "height": 260,
        "width": 520,
        "color": 4
      },
      "id": "552a139f-6a06-4092-a499-ce739e4ca25b",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -380
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gearup-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0009fdb4-a3cf-4f1e-bc91-b35274b9b4bc",
      "name": "Wholesale form webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b4259dfd-a5e6-4e59-be77-3ad015ba6f85"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst clean = v => String(v ?? '').trim();\nconst email = clean(b.email).toLowerCase();\nconst valid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst freeMail = ['gmail.com','yahoo.com','outlook.com','hotmail.com','icloud.com','mail.ru','yandex.ru','example.com'];\nlet website = clean(b.website);\nlet domain = website.replace(/^https?:\\/\\//,'').replace(/^www\\./,'').split('/')[0];\nif (!domain && valid) {\n  const d = email.split('@')[1];\n  if (!freeMail.includes(d)) domain = d;\n}\nreturn [{ json: {\n  lead_id: 'L-' + Date.now().toString(36).toUpperCase(),\n  created_at: new Date().toISOString().slice(0,16).replace('T',' '),\n  company: clean(b.company), contact_name: clean(b.contact_name), email, phone: clean(b.phone),\n  website: domain, size: clean(b.size), budget_usd: clean(b.budget_usd), message: clean(b.message).slice(0, 2000),\n  valid\n}}];"
      },
