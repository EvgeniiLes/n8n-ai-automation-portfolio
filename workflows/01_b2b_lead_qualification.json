      "id": "36de987d-4cdd-40d9-b85c-388200f92d75",
      "name": "Fetch company website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -40
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
