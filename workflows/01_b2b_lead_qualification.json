    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Normalize & validate').first().json;\nconst html = typeof $json.html === 'string' ? $json.html : '';\nconst pick = re => (html.match(re) || [,''])[1].replace(/\\s+/g,' ').trim().slice(0, 300);\nreturn { json: { ...lead,\n  site_title: pick(/<title[^>]*>([^<]*)<\\/title>/i),\n  site_description: pick(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)/i),\n  site_reachable: html.length > 0\n}};"
      },
      "id": "847e9e82-54d0-4991-a9c9-efcbec2a6863",
      "name": "Extract site info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -40
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Wholesale lead:\nCompany: {{ $json.company || '—' }}\nContact: {{ $json.contact_name }} <{{ $json.email }}> {{ $json.phone }}\nSize: {{ $json.size || '—' }}\nBudget (USD): {{ $json.budget_usd || '—' }}\nMessage: {{ $json.message }}\nWebsite: {{ $json.website || '—' }} | reachable: {{ $json.site_reachable }}\nSite title: {{ $json.site_title }}\nSite description: {{ $json.site_description }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a B2B sales analyst for GearUp, an online store of fitness equipment that sells wholesale to gyms, studios and clubs (10-25% volume discounts, delivery EU/UK/US/CA).\nScore the lead from 0 to 100:\n- business type fit (gym/studio/club/hotel/corporate = high, private person = low)\n- clear need (specific products, quantities) and timeline\n- budget size (>5000 USD high)\n- legitimacy (company domain email, working website)\nReturn ONLY valid JSON, no markdown:\n{\"score\": number, \"tier\": \"hot\"|\"warm\"|\"cold\", \"reason\": \"one sentence\", \"next_step\": \"one sentence for the sales manager\", \"products\": [\"GearUp product categories that fit\"], \"email_subject\": \"string\", \"email_body\": \"short friendly first email in the lead's language, max 120 words, signed 'Alex, GearUp B2B team', no placeholders\"}\nhot >= 70, warm 40-69, cold < 40."
            }
          ]
        }
      },
      "id": "072f98f9-ea97-46a0-bc35-8bcbc76d89bd",
      "name": "AI lead scoring",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
