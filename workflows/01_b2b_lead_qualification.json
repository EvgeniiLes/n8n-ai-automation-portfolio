      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst l = $('Parse AI result').first().json;\nreturn { json: { text:\n`🔥 <b>Hot B2B lead · ${l.score}/100</b>\n<b>${esc(l.company || 'No company')}</b> — ${esc(l.contact_name)}\n📧 ${esc(l.email)} ${l.phone ? '· 📞 ' + esc(l.phone) : ''}\n👥 ${esc(l.size || '—')} · 💰 ${esc(l.budget_usd || '—')} USD\n\n💬 <i>${esc(l.message.slice(0, 400))}</i>\n\n🧠 ${esc(l.reason)}\n👉 <b>Next:</b> ${esc(l.next_step)}\n🛒 ${esc(l.products)}` } };"
      },
