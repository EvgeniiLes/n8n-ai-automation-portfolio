          "value": {
            "question": "={{ $fromAI('question', 'The user question that the knowledge base could not answer', 'string') }}",
            "asked_at": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "asked_by": "={{ $('Telegram trigger').first().json.message.from.username || $('Telegram trigger').first().json.message.from.first_name }}"
          },
