      "id": "603318da-b234-4d14-bbaf-12780a673c4e",
      "name": "Read leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        0
      ],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const orders = $('Read orders').all().map(i => i.json);\nconst lines = $('Read order lines').all().map(i => i.json);\nconst products = $('Read products').all().map(i => i.json);\nconst leads = $('Read leads').all().map(i => i.json);\nconst day = d => String(d || '').slice(0, 10);\nconst y = $now.minus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst weekAgo = $now.minus({ days: 8 }).toFormat('yyyy-MM-dd');\nconst yOrders = orders.filter(o => day(o.created_at) === y);\nconst revenue = yOrders.reduce((s, o) => s + Number(o.total || 0), 0);\nconst prev7 = orders.filter(o => day(o.created_at) >= weekAgo && day(o.created_at) < y);\nconst avg7 = prev7.reduce((s, o) => s + Number(o.total || 0), 0) / 7;\nconst bySku = {};\nfor (const l of lines.filter(l => day(l.created_at) === y)) {\n  bySku[l.name] = (bySku[l.name] || 0) + Number(l.qty || 0);\n}\nconst top = Object.entries(bySku).sort((a, b) => b[1] - a[1]).slice(0, 3);\nconst low = products.filter(p => Number(p.stock) <= Number(p.reorder_level)).map(p => `${p.name} (${p.stock})`);\nconst newLeads = leads.filter(l => day(l.created_at) === y);\nconst hot = newLeads.filter(l => l.tier === 'hot').length;\nconst k = {\n  date: y, orders: yOrders.length, revenue: Math.round(revenue * 100) / 100,\n  aov: yOrders.length ? Math.round(revenue / yOrders.length) : 0,\n  vs_avg_pct: avg7 ? Math.round((revenue / avg7 - 1) * 100) : null,\n  top_products: top.map(([n, q]) => `${n} ×${q}`), low_stock: low,\n  new_leads: newLeads.length, hot_leads: hot,\n  processing: orders.filter(o => o.status === 'processing').length\n};\nreturn [{ json: k }];"
      },
      "id": "996530f1-5a7c-4a5b-b97e-e9795e3bc3a1",
      "name": "Calculate KPIs",
