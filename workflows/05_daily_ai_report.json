      },
      "id": "c0af644e-b04a-4b9c-845c-559b1c4bdfee",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst k = $('Calculate KPIs').first().json;\nconst trend = k.vs_avg_pct === null ? '' : (k.vs_avg_pct >= 0 ? ` (▲ ${k.vs_avg_pct}% vs 7-day avg)` : ` (▼ ${Math.abs(k.vs_avg_pct)}% vs 7-day avg)`);\nconst text = `☀️ <b>GearUp · report for ${k.date}</b>\n\n💰 Revenue: <b>$${k.revenue.toLocaleString('en-US')}</b>${trend}\n🧾 Orders: <b>${k.orders}</b> · AOV $${k.aov}\n⏳ Waiting to ship: ${k.processing}\n🏆 Top: ${esc(k.top_products.join(', ') || '—')}\n📉 Low stock: ${esc(k.low_stock.join(', ') || 'none')}\n🤝 New B2B leads: ${k.new_leads} (🔥 ${k.hot_leads} hot)\n\n🧠 <i>${esc($json.text.trim())}</i>`;\nreturn [{ json: { text } }];"
      },
      "id": "c666a43e-0b3e-4abf-af04-aab8a5d224ae",
