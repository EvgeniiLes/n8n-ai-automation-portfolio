        "jsCode": "const esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst s = $('Calculate new stock').item.json;\nreturn { json: { text: `📉 <b>Low stock: ${esc(s.name)}</b>\\nSKU <code>${esc(s.sku)}</code> · left <b>${s.stock}</b> (reorder level ${s.reorder_level})\\nAfter order ${esc(s.order_id)}. Time to reorder from the supplier.` } };"
      },
