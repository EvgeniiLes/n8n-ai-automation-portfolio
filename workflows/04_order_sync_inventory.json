    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const line = $('Split line items').item.json;\nconst stock = Number($json.stock) || 0;\nconst reorder = Number($json.reorder_level) || 0;\nconst newStock = Math.max(0, stock - line.qty);\nreturn { json: { sku: line.sku, name: $json.name || line.name, old_stock: stock, stock: newStock, reorder_level: reorder,\n  updated_at: $now.toFormat('yyyy-MM-dd HH:mm'), low: newStock <= reorder, order_id: line.order_id } };"
      },
